# LF everywhere, including on Windows checkouts.
* text=auto eol=lf

# Captured feed fixtures stay byte-for-byte: the CIF delivery excerpt is
# CRLF, as Network Rail delivers it, and the tests parse it that way.
crates/*/tests/fixtures/** -text

# Collapse lockfiles in diffs and leave them out of language stats.
*.lock              linguist-generated=true
package-lock.json   linguist-generated=true

# Copies of crates/ds-store/db-grants.yaml and access/redis-users.acl.tpl
# (scripts/sync-chart-core-files.py): review the sources instead.
charts/distant-signal/files/db-grants.yaml       linguist-generated=true
charts/distant-signal/files/redis-users.acl.tpl  linguist-generated=true

# Binary assets.
*.png binary
*.zip binary
